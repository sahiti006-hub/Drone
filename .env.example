# ==============================================================================
# Smart Emergency Drone Delivery System - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR ENVIRONMENT-SPECIFIC CREDENTIALS:
#   cp .env.example .env
#
# DO NOT COMMIT THE REAL .env FILE OR SENSITIVE PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Mode
# ------------------------------------------------------------------------------
# Options: development | testing | production
FLASK_ENV=development

# Entrypoint script
FLASK_APP=wsgi.py

# Debug mode (0 = Disabled for Production, 1 = Enabled for Development ONLY)
FLASK_DEBUG=0

# Secret Key for cryptographic session signing and CSRF tokens.
# IN PRODUCTION: Generate a 64-character random hex string:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_for_production

# ------------------------------------------------------------------------------
# 2. Network & Server Settings
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000

# Reverse Proxy / HTTPS Settings (Set USE_PROXY_FIX=1 when behind Nginx/Caddy/ALB)
USE_PROXY_FIX=0
PROXY_FIX_FOR=1
PROXY_FIX_PROTO=1
PROXY_FIX_HOST=1
PROXY_FIX_PREFIX=1

# Session Security (1 = enforce HTTPS-only cookies; 0 = permit HTTP for local testing)
SESSION_COOKIE_SECURE=0

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# Option A: MySQL Connection Parameters (Recommended for Production & Multi-User)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=drone_user
DB_PASSWORD=your_strong_mysql_password_here
DB_NAME=smart_emergency_drone_db

# Option B: Direct Database Connection URL (Overrides individual DB_* settings)
# Example MySQL: mysql+pymysql://drone_user:your_password@127.0.0.1:3306/smart_emergency_drone_db?charset=utf8mb4
# Example SQLite: sqlite:///instance/drone_system.db
# DATABASE_URL=

# Option C: Standalone Demonstration Flag (Permits SQLite when FLASK_ENV=production)
ALLOW_SQLITE_IN_PRODUCTION=0

# ------------------------------------------------------------------------------
# 4. Master Administrator Provisioning (Used by scripts/create_admin.py)
# ------------------------------------------------------------------------------
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@emergencydrone.org
ADMIN_PASSWORD=change_this_to_a_strong_admin_password_min_8_chars

# ------------------------------------------------------------------------------
# 5. Drone Fleet & Simulation Physics Parameters
# ------------------------------------------------------------------------------
SIMULATION_SPEED_MULTIPLIER=1.0
MAX_DRONE_PAYLOAD_KG=5.0
DEFAULT_DRONE_BATTERY_MAH=5000
DISPATCH_INTERVAL_SECONDS=5
